# Template: copy to secrets.env.op and fill in. Values are 1Password references (op://...), never secrets.
# Usage: op run --env-file secrets.env.op -- <command>
GRAFANA_URL=https://<your-stack>.grafana.net
GRAFANA_AUTH=op://<vault>/<item>/credential

# Grafana Cloud metrics push (Influx line protocol): instance ID as username, write-only token as password.
# TF_VAR_<name> sets the Terraform variable <name> declared in variables.tf.
TF_VAR_grafana_metrics_write_url=https://prometheus-prod-<NN>-prod-<region>.grafana.net/api/v1/push/influx/write
TF_VAR_grafana_metrics_instance_id=<instance-id>
TF_VAR_grafana_metrics_write_token=op://<vault>/<item>/credential

# GitHub provider: repo owner, and a fine-grained token (Administration + Environments, this repo only).
GITHUB_OWNER=<github-user>
GITHUB_TOKEN=op://<vault>/<item>/credential
